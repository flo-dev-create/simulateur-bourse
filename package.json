{
  "name": "simulateur-bourse",
  "private": true,
  "version": "1.0.0",
  "description": "Simulateur financier S&P 500 vs CAC 40",
  "author": "Florian Galera",
  "type": "module",
  "main": "electron.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron:dist": "vite build && electron-builder --win nsis"
  },
  "dependencies": {
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.8.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.0"
  },
  "build": {
    "appId": "com.simulateur.bourse",
    "productName": "Simulateur Bourse",
